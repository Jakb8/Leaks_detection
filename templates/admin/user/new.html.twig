{% extends 'base.html.twig' %}

{% block title %}Add user - WatchLeaks{% endblock %}

{% block body %}
<div class="mb-4">
    <a href="{{ path('app_admin_user_index') }}" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i> Back to users</a>
    <h3 class="fw-bold mb-0 mt-1">Add user</h3>
    <small class="text-muted">Create a new account for a colleague or client</small>
</div>

<div class="card p-4" style="max-width: 640px;">
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('user_form') }}">
        {% include 'admin/user/_form.html.twig' with {requirePassword: true} %}
        <button class="btn btn-primary btn-lg w-100"><i class="bi bi-person-plus me-1"></i> Create user</button>
    </form>
</div>
{% endblock %}
