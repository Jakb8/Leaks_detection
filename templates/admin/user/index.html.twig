{% extends 'base.html.twig' %}

{% block title %}Users - WatchLeaks{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Users</h3>
        <small class="text-muted">Manage who can log in and what they can see · {{ users|length }} account(s)</small>
    </div>
    <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary btn-lg">
        <i class="bi bi-person-plus-lg me-1"></i> Add user
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Company</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Last login</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                <tr>
                    <td class="fw-semibold">{{ u.email }}</td>
                    <td>{{ u.fullName ?: '—' }}</td>
                    <td>{{ u.company ?: '—' }}</td>
                    <td>
                        {% if u.isAdmin %}
                            <span class="badge bg-primary">Admin</span>
                        {% else %}
                            <span class="badge bg-secondary">Client</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if u.isActive %}
                            <span class="badge bg-success">Active</span>
                        {% else %}
                            <span class="badge bg-secondary">Disabled</span>
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ u.lastLoginAt ? u.lastLoginAt|date('Y-m-d H:i') : 'Never' }}</td>
                    <td class="text-end">
                        <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn btn-sm btn-outline-secondary" title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('app_admin_user_toggle', {id: u.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('user_toggle' ~ u.id) }}">
                            <button class="btn btn-sm btn-outline-{{ u.isActive ? 'warning' : 'success' }}" title="{{ u.isActive ? 'Deactivate' : 'Activate' }}">
                                <i class="bi bi-{{ u.isActive ? 'pause' : 'play' }}"></i>
                            </button>
                        </form>
                        <form method="post" action="{{ path('app_admin_user_delete', {id: u.id}) }}" class="d-inline" onsubmit="return confirm('Delete {{ u.email }}?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('user_delete' ~ u.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">No users yet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
