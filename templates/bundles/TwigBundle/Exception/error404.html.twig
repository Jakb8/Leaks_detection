{% extends 'base.html.twig' %}

{% block title %}Page not found - WatchLeaks{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8 text-center py-5">
        <i class="bi bi-exclamation-diamond display-1 text-warning"></i>
        <h1 class="fw-bold mt-3">404 — Page not found</h1>
        <p class="text-muted">The page you requested does not exist or has been moved.</p>
        <a href="{{ path('app_dashboard') }}" class="btn btn-primary mt-2">
            <i class="bi bi-house me-1"></i> Back to dashboard
        </a>
    </div>
</div>
{% endblock %}
