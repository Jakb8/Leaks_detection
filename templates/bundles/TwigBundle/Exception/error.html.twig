{% extends 'base.html.twig' %}

{% block title %}Error - WatchLeaks{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-8 text-center py-5">
        <i class="bi bi-shield-exclamation display-1 text-danger"></i>
        <h1 class="fw-bold mt-3">Something went wrong</h1>
        <p class="text-muted">The request could not be completed. Please try again in a moment.</p>
        {% if status_code == 403 %}
            <p class="small text-muted">You do not have permission to access this resource.</p>
        {% endif %}
        <a href="{{ path('app_dashboard') }}" class="btn btn-primary mt-2">
            <i class="bi bi-house me-1"></i> Back to dashboard
        </a>
    </div>
</div>
{% endblock %}
