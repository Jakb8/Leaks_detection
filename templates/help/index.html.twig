{% extends 'base.html.twig' %}

{% block title %}Help &amp; Glossary - WatchLeaks{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Help &amp; Glossary</h3>
        <small class="text-muted">Plain-language explanations of everything you see in WatchLeaks</small>
    </div>
    <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to dashboard</a>
</div>

{# How WatchLeaks works, step by step #}
<div class="card p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-signpost-split me-2"></i>How WatchLeaks works</h5>
    <div class="row g-3">
        <div class="col-md-3">
            <div class="border rounded p-3 h-100">
                <span class="badge bg-primary mb-2">Step 1</span>
                <h6 class="fw-bold">Add a domain</h6>
                <p class="small text-muted mb-0">Enter the domain you want to protect (e.g. <code>example.com</code>). WatchLeaks starts monitoring it immediately.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3 h-100">
                <span class="badge bg-primary mb-2">Step 2</span>
                <h6 class="fw-bold">Automatic scanning</h6>
                <p class="small text-muted mb-0">A background worker checks the domain against four free public threat-intelligence sources every few minutes.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3 h-100">
                <span class="badge bg-primary mb-2">Step 3</span>
                <h6 class="fw-bold">Findings appear</h6>
                <p class="small text-muted mb-0">New breaches, stolen credentials and ransomware listings show up on the Dashboard and in Data Leaks, ranked by severity.</p>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-3 h-100">
                <span class="badge bg-primary mb-2">Step 4</span>
                <h6 class="fw-bold">Respond</h6>
                <p class="small text-muted mb-0">Reset the affected passwords, enable 2FA, then mark the leak as <strong>Resolved</strong> once fixed.</p>
            </div>
        </div>
    </div>
</div>

{# Connecting data sources #}
<div class="card p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-plug me-2"></i>Connecting data sources</h5>
        <a href="{{ path('app_audit') }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-search me-1"></i> Domain Audit</a>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="border rounded p-3 h-100">
                <h6 class="fw-bold">Free sources (no key)</h6>
                <p class="small text-muted mb-2">XposedOrNot, ransomware.live, Hudson Rock and LeakRadar aggregate reports are checked automatically for each monitored domain.</p>
                <p class="small mb-0">In <a href="{{ path('app_settings') }}">Settings</a>, enable <strong>automatic leak scanning</strong> and use <strong>Sync Now</strong>.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="border rounded p-3 h-100">
                <h6 class="fw-bold">XposedOrNot key</h6>
                <p class="small text-muted mb-2">Optional. Adds authenticated breach lookups for one verified domain per key. Get it from your <a href="https://xposedornot.com/dashboard">XposedOrNot dashboard</a>.</p>
                <p class="small mb-0">Paste it in Settings → <strong>Optional API keys</strong>. Leave the field blank to keep the current key; check <strong>Clear</strong> to remove it.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="border rounded p-3 h-100">
                <h6 class="fw-bold">LeakRadar key</h6>
                <p class="small text-muted mb-2">Optional. Unlocks individual email/password records; public aggregate counts already work without a key. See <a href="https://docs.leakradar.io">LeakRadar docs</a>.</p>
                <p class="small mb-0">Paste it in Settings → <strong>Optional API keys</strong> using the same blank/clear rules.</p>
            </div>
        </div>
    </div>
    <hr>
    <h6 class="fw-bold">Attacks API (your IDS/WAF/SIEM)</h6>
    <p class="small text-muted">Point WatchLeaks at any JSON endpoint. A bare array or an object under <code>data</code>, <code>events</code>, <code>results</code>, <code>items</code>, <code>attacks</code> or <code>leaks</code> is accepted. Common field names are auto-mapped:</p>
    <pre class="wl-code p-3 rounded small mb-0"><code>[{
  "id": "evt-123",
  "timestamp": "2026-11-17T14:00:00Z",
  "severity": "high",
  "source_ip": "203.0.113.10",
  "endpoint": "/login",
  "type": "sql injection",
  "status": "blocked"
}]</code></pre>
    <p class="small text-muted mt-2 mb-0">Set the endpoint URL, method (GET/POST), optional auth header and token, then enable it. Duplicates are ignored using the event <code>id</code> or a content fingerprint.</p>
</div>

{# Severity levels #}
<div class="card p-4 mb-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-steps me-2"></i>Severity levels</h5>
    <table class="table align-middle mb-0">
        <thead class="table-light">
            <tr><th style="width:140px">Level</th><th>What it means</th></tr>
        </thead>
        <tbody>
            {% for s in severities %}
            <tr class="severity-{{ s.class }}">
                <td><span class="badge bg-{{ s.badge }}">{{ s.level }}</span></td>
                <td class="small">{{ s.meaning }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Glossary #}
<div class="card p-4">
    <h5 class="fw-bold mb-3"><i class="bi bi-book me-2"></i>Glossary</h5>
    <div class="row g-3">
        {% for item in glossary %}
        <div class="col-md-6">
            <div class="border rounded p-3 h-100">
                <h6 class="fw-bold mb-1"><i class="bi {{ item.icon }} me-2 text-primary"></i>{{ item.term }}</h6>
                <p class="small text-muted mb-0">{{ item.definition|raw }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
