<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}WatchLeaks{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    {% block stylesheets %}
        <style>
            :root {
                --sidebar-width: 250px;
                --sidebar-bg: #1a1d21;
                --sidebar-link: #adb5bd;
                --sidebar-link-active: #ffffff;
                --card-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
            }

            body {
                background-color: #f4f6f9;
            }

            .sidebar {
                width: var(--sidebar-width);
                min-height: 100vh;
                background-color: var(--sidebar-bg);
                position: fixed;
                top: 0;
                left: 0;
                z-index: 1030;
                padding-top: 1rem;
                overflow-y: auto;
            }

            .sidebar .nav-link {
                color: var(--sidebar-link);
                padding: 0.75rem 1.25rem;
                border-left: 3px solid transparent;
            }

            .sidebar .nav-link:hover {
                color: #fff;
                background-color: rgba(255, 255, 255, 0.05);
            }

            .sidebar .nav-link.active {
                color: var(--sidebar-link-active);
                background-color: rgba(255, 255, 255, 0.08);
                border-left-color: #0d6efd;
            }

            .content {
                margin-left: var(--sidebar-width);
                padding: 1.5rem;
            }

            .card {
                border: none;
                box-shadow: var(--card-shadow);
            }

            .stat-card {
                border-radius: 0.5rem;
            }

            .attack-pulse {
                animation: pulse-animation 1.5s ease-in-out infinite;
            }

            @keyframes pulse-animation {
                0% { opacity: 1; }
                50% { opacity: 0.4; }
                100% { opacity: 1; }
            }

            .severity-critical { border-left: 4px solid #dc3545; }
            .severity-high { border-left: 4px solid #ffc107; }
            .severity-medium { border-left: 4px solid #0dcaf0; }
            .severity-low { border-left: 4px solid #198754; }

            .table > :not(caption) > * > * {
                vertical-align: middle;
            }

            .new-row {
                background-color: #fff3cd !important;
            }

            .new-row.highlight {
                transition: background-color 1.5s ease;
                background-color: transparent !important;
            }

            @media (max-width: 991.5px) {
                .sidebar {
                    transform: translateX(-100%);
                    transition: transform 0.2s ease-in-out;
                }

                #sidebarNav.show .sidebar {
                    transform: translateX(0);
                }

                .content {
                    margin-left: 0;
                    padding-top: 4rem;
                }
            }
        </style>
    {% endblock %}
    {% block head %}{% endblock %}
</head>
<body>
{% if app.user %}
    <a class="visually-hidden-focusable" href="#main-content">Skip to content</a>
    <button class="btn btn-primary d-lg-none position-fixed top-0 start-0 m-2" style="z-index:1100" type="button"
            data-bs-toggle="collapse" data-bs-target="#sidebarNav" aria-controls="sidebarNav"
            aria-expanded="false" aria-label="Toggle navigation">
        <i class="bi bi-list"></i>
    </button>
    <div id="sidebarNav" class="collapse d-lg-block">
        {% include 'partials/sidebar.html.twig' %}
    </div>
    <div class="content" id="main-content">
        {% include 'partials/flashes.html.twig' %}
        {% block body %}{% endblock %}
    </div>
{% else %}
    <div class="container-fluid">
        {% include 'partials/flashes.html.twig' %}
        {% block body_no_auth %}{% endblock %}
    </div>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
