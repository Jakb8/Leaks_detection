{% if feed.lastStatus == 'ok' %}
    <span class="badge bg-success" title="{{ feed.lastMessage }}">
        <i class="bi bi-check-circle me-1"></i>OK
    </span>
{% elseif feed.lastStatus == 'error' %}
    <span class="badge bg-danger" title="{{ feed.lastMessage }}">
        <i class="bi bi-exclamation-triangle me-1"></i>Error
    </span>
{% elseif feed.lastStatus == 'skipped' %}
    <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i>Disabled</span>
{% else %}
    <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1"></i>Never run</span>
{% endif %}
{% if feed.lastSyncedAt %}
    <small class="text-muted ms-2">{{ feed.lastSyncedAt|date('H:i:s') }} · {{ feed.lastImportedCount }} imported</small>
{% endif %}
