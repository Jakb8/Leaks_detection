{% extends 'base.html.twig' %}

{% block title %}Domains - WatchLeaks{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Domains</h3>
        <small class="text-muted">{% if isAdmin %}Manage all monitored domains{% else %}Your monitored domains{% endif %}</small>
    </div>
    <a href="{{ path('app_domain_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Add Domain
    </a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    {% if isAdmin %}<th>Owner</th>{% endif %}
                    <th>API Key</th>
                    <th>Monitoring</th>
                    <th>Last Scan</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for domain in domains %}
                <tr>
                    <td class="fw-semibold">
                        <i class="bi bi-globe2 me-2 text-primary"></i>{{ domain.name }}
                    </td>
                    {% if isAdmin %}
                        <td>{{ domain.owner ? domain.owner.email : '-' }}</td>
                    {% endif %}
                    <td>
                        <code class="small">{{ domain.apiKey ? domain.apiKey|slice(0,12) ~ '…' : '-' }}</code>
                    </td>
                    <td>
                        {% if domain.monitoringEnabled %}
                            <span class="badge bg-success">Active</span>
                        {% else %}
                            <span class="badge bg-secondary">Paused</span>
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ domain.lastScanAt ? domain.lastScanAt|date('Y-m-d H:i') : 'Never' }}</td>
                    <td class="text-end">
                        <a href="{{ path('app_domain_show', {id: domain.id}) }}" class="btn btn-sm btn-outline-primary me-1" title="View" aria-label="View">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('app_domain_edit', {id: domain.id}) }}" class="btn btn-sm btn-outline-secondary me-1" title="Edit" aria-label="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('app_domain_delete', {id: domain.id}) }}" class="d-inline" onsubmit="return confirm('Delete this domain and all its data?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ domain.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="{{ isAdmin ? 7 : 6 }}" class="text-center text-muted py-4">No domains found. <a href="{{ path('app_domain_new') }}">Add your first domain</a>.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
