{% extends 'base.html.twig' %}

{% block title %}Edit Domain - WatchLeaks{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card p-4">
            <h5 class="fw-bold mb-3">Edit Domain: {{ domain.name }}</h5>
            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_row(form.name) }}
                </div>
                <div class="mb-3">
                    {{ form_row(form.monitoringEnabled) }}
                </div>
                {% if form.owner is defined %}
                    <div class="mb-3">
                        {{ form_row(form.owner) }}
                    </div>
                {% endif %}
                <div class="d-flex justify-content-end gap-2">
                    <a href="{{ path('app_domain_index') }}" class="btn btn-secondary">Cancel</a>
                    <button class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Save
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
