{% extends 'base.html.twig' %}

{% block title %}Record Attack - WatchLeaks{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card p-4">
            <h5 class="fw-bold mb-3">Record Attack Event</h5>
            {{ form_start(form) }}
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.domain) }}</div>
                    <div class="col-md-6">{{ form_row(form.type) }}</div>
                    <div class="col-md-4">{{ form_row(form.severity) }}</div>
                    <div class="col-md-4">{{ form_row(form.status) }}</div>
                    <div class="col-md-4">{{ form_row(form.sourceIp) }}</div>
                    <div class="col-md-4">{{ form_row(form.endpoint) }}</div>
                    <div class="col-md-4">{{ form_row(form.httpMethod) }}</div>
                    <div class="col-md-4">{{ form_row(form.country) }}</div>
                    <div class="col-12">{{ form_row(form.userAgent) }}</div>
                    <div class="col-12">{{ form_row(form.payload) }}</div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a href="{{ path('app_attack_index') }}" class="btn btn-secondary">Cancel</a>
                    <button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
