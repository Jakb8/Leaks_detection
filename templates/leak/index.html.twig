{% extends 'base.html.twig' %}

{% block title %}Data Leaks - WatchLeaks{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-0">Data Leaks</h3>
        <small class="text-muted">{% if isAdmin %}All domains{% else %}Your domains{% endif %} · {{ leaks|length }} records</small>
    </div>
    <div class="d-flex gap-2">
        <a href="{{ path('app_leak_index', {severity: severity, type: type, q: q, unresolved: unresolved ? 1 : null, export: 'csv'}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <a href="{{ path('app_leak_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Record Leak
        </a>
    </div>
</div>

<div class="card p-3 mb-4">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small" for="filter-severity">Severity</label>
            <select name="severity" id="filter-severity" class="form-select form-select-sm">
                <option value="">All</option>
                {% for s in severities %}
                <option value="{{ s.value }}" {{ severity == s.value ? 'selected' }}>{{ s.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small" for="filter-type">Type</label>
            <select name="type" id="filter-type" class="form-select form-select-sm">
                <option value="">All</option>
                {% for t in types %}
                <option value="{{ t.value }}" {{ type == t.value ? 'selected' }}>{{ t.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small" for="filter-unresolved">Status</label>
            <div class="form-check form-switch mt-2">
                <input class="form-check-input" type="checkbox" name="unresolved" value="1" id="filter-unresolved" {{ unresolved ? 'checked' }}>
                <label class="form-check-label small" for="filter-unresolved">Unresolved only</label>
            </div>
        </div>
        <div class="col-md-2">
            <label class="form-label small" for="filter-q">Search</label>
            <input type="search" name="q" id="filter-q" value="{{ q }}" class="form-control form-control-sm" placeholder="Email, IP, source, data…">
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i> Filter</button>
            <a href="{{ path('app_leak_index') }}" class="btn btn-sm btn-outline-secondary" aria-label="Reset filters" title="Reset filters"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Domain</th>
                    <th>Type</th>
                    <th>Severity</th>
                    <th>Data Sample</th>
                    <th>Email</th>
                    <th>Detected</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for leak in leaks %}
                <tr class="severity-{{ leak.severity.value }}">
                    <td class="fw-semibold">{{ leak.domain.name }}</td>
                    <td>{{ leak.type.label }}</td>
                    <td><span class="badge bg-{{ leak.severity.badgeClass }}">{{ leak.severity.label }}</span></td>
                    <td><code class="small">{{ leak.dataSample|slice(0,40) }}{% if leak.dataSample|length > 40 %}…{% endif %}</code></td>
                    <td class="small">{{ leak.email ?: '-' }}</td>
                    <td class="small text-muted">{{ leak.detectedAt|date('Y-m-d H:i') }}</td>
                    <td>
                        {% if leak.resolved %}
                            <span class="badge bg-success">Resolved</span>
                        {% else %}
                            <span class="badge bg-danger">Open</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Details" aria-label="Details"
                                data-bs-toggle="modal" data-bs-target="#leakDetailModal"
                                data-domain="{{ leak.domain.name }}"
                                data-type="{{ leak.type.label }}"
                                data-severity="{{ leak.severity.label }}"
                                data-source="{{ leak.source }}"
                                data-email="{{ leak.email ?: '-' }}"
                                data-detected="{{ leak.detectedAt|date('Y-m-d H:i') }}"
                                data-resolved="{{ leak.resolved ? 'Resolved' : 'Open' }}"
                                data-sample="{{ leak.dataSample }}"><i class="bi bi-eye"></i></button>
                        {% if not leak.resolved %}
                        <form method="post" action="{{ path('app_leak_resolve', {id: leak.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('resolve' ~ leak.id) }}">
                            <button class="btn btn-sm btn-outline-success" title="Resolve" aria-label="Resolve"><i class="bi bi-check"></i></button>
                        </form>
                        {% endif %}
                        <form method="post" action="{{ path('app_leak_delete', {id: leak.id}) }}" class="d-inline" onsubmit="return confirm('Delete this leak?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ leak.id) }}">
                            <button class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="8" class="text-center text-muted py-4">
                    {% if severity or type or q or unresolved %}
                        No leak matches these filters. <a href="{{ path('app_leak_index') }}">Reset filters</a>.
                    {% else %}
                        No data leaks found. <a href="{{ path('app_leak_new') }}">Record the first one</a>.
                    {% endif %}
                </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="leakDetailModal" tabindex="-1" aria-labelledby="leakDetailTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="leakDetailTitle">Leak Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-3">
                    <dt class="col-sm-3">Domain</dt><dd class="col-sm-9" id="lkDomain">-</dd>
                    <dt class="col-sm-3">Type</dt><dd class="col-sm-9" id="lkType">-</dd>
                    <dt class="col-sm-3">Severity</dt><dd class="col-sm-9" id="lkSeverity">-</dd>
                    <dt class="col-sm-3">Source</dt><dd class="col-sm-9" id="lkSource">-</dd>
                    <dt class="col-sm-3">Email</dt><dd class="col-sm-9" id="lkEmail">-</dd>
                    <dt class="col-sm-3">Detected</dt><dd class="col-sm-9" id="lkDetected">-</dd>
                    <dt class="col-sm-3">Status</dt><dd class="col-sm-9" id="lkResolved">-</dd>
                </dl>
                <h6 class="fw-bold">Exposed data</h6>
                <pre id="lkSample" class="bg-body-tertiary border rounded p-3" style="white-space:pre-wrap; word-break:break-word; font-size:.85rem;">-</pre>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    const modal = document.getElementById('leakDetailModal');
    if (modal) {
        modal.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            if (!btn) return;
            const d = btn.dataset;
            document.getElementById('leakDetailTitle').textContent = 'Leak — ' + d.domain;
            document.getElementById('lkDomain').textContent = d.domain || '-';
            document.getElementById('lkType').textContent = d.type || '-';
            document.getElementById('lkSeverity').textContent = d.severity || '-';
            document.getElementById('lkSource').textContent = d.source || '-';
            document.getElementById('lkEmail').textContent = d.email || '-';
            document.getElementById('lkDetected').textContent = d.detected || '-';
            document.getElementById('lkResolved').textContent = d.resolved || '-';
            document.getElementById('lkSample').textContent = d.sample || '-';
        });
    }
</script>
{% endblock %}
